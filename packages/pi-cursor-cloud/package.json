  "engines": { "node": ">=22.19.0" },
  "dependencies": { "@cursor/sdk": "1.0.35" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^1.0.2",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.mjs",

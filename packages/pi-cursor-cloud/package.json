  "repository": {
    "type": "git",
    "url": "git+https://github.com/iurysza/pi-extensions.git",
    "directory": "packages/pi-cursor-cloud"
  },
  "bugs": { "url": "https://github.com/iurysza/pi-extensions/issues" },

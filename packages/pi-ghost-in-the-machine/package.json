{
  "name": "@iurysza/pi-ghost-in-the-machine",
  "version": "0.1.0",
  "description": "A Ghostty shader face that reacts to Pi lifecycle states.",
  "license": "MIT",
  "author": "Iury Souza",
  "type": "module",
  "main": "src/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ghostty",
    "shader",
    "herdr",
    "lifecycle"
  ],
  "files": [
    "src",
    "scripts/ghost-state.sh",
    "scripts/setup.sh",
    "scripts/sidebar-watcher.mjs",
    "scripts/watch-sidebar.sh",
    "shaders",
    "herdr-plugin.toml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iurysza/pi-extensions.git",
    "directory": "packages/pi-ghost-in-the-machine"
  },
  "bugs": {
    "url": "https://github.com/iurysza/pi-extensions/issues"
  },
  "homepage": "https://github.com/iurysza/pi-extensions/tree/main/packages/pi-ghost-in-the-machine#readme",
  "scripts": {
    "check": "npm run typecheck && bash -n scripts/*.sh && npm run check:generated",
    "check:generated": "npm run generate && git diff --exit-code -- shaders/variants",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "bash scripts/generate-variants.sh",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}

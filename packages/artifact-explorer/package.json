  "description": "Open each repository's ai-artifacts directory as an isolated Obsidian vault.",
  "license": "MIT",
  "author": "Iury Souza",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "obsidian",
    "artifacts"
  ],
  "files": [
    "index.ts",
    "lib",
    "workspace-overlay",
    "config.json.example",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {

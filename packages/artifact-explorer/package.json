    "directory": "packages/artifact-explorer"
  },
  "bugs": {
    "url": "https://github.com/iurysza/pi-extensions/issues"
  },
  "homepage": "https://github.com/iurysza/pi-extensions/tree/main/packages/artifact-explorer#readme",
  "scripts": {
    "check": "npm run typecheck && npm test",

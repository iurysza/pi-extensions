{
  "name": "@iurysza/pi-agent-explorer",
  "version": "0.1.0",
  "description": "Explore Pi's loaded resources in a read-only Neovim snapshot.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "herdr",
    "neovim"
  ],
  "files": [
    "extensions",
    "herdr",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iurysza/pi-extensions.git",
    "directory": "packages/pi-agent-explorer"
  },
  "bugs": {
    "url": "https://github.com/iurysza/pi-extensions/issues"
  },
  "homepage": "https://github.com/iurysza/pi-extensions/tree/main/packages/pi-agent-explorer#readme",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node --input-type=module -e \"import { bundle } from '@iurysza/herdr-ui/bundle'; bundle(process.cwd())\"",
    "postpack": "node --input-type=module -e \"import { unbundle } from '@iurysza/herdr-ui/bundle'; unbundle(process.cwd())\""
  },
  "pi": {
    "extensions": [
      "./extensions/agent-explorer.ts"
    ]
  },
  "dependencies": {
    "@iurysza/herdr-ui": "0.1.0"
  },
  "bundleDependencies": [
    "@iurysza/herdr-ui"
  ]
}

  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
